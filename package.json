{
	"name": "freeosintui",
	"private": true,
	"version": "0.0.1",
	"license": "SEE LICENSE IN LICENSE",
	"author": "kerlo (https://github.com/Kerlooo)",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:all": "concurrently -k -n web,api -c green,cyan \"vite dev\" \"cd backend && uv run uvicorn app.main:app --reload --port 8000\"",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"concurrently": "^10.0.5",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"exifr": "^7.1.3",
		"fflate": "^0.8.3",
		"hash-wasm": "^4.12.0",
		"libphonenumber-js": "^1.13.14"
	}
}
